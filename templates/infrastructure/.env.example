# ─────────────────────────────────────────────────────────────────────────────
# __MKTRUE_NAME__-infrastructure — copy to `.env` and fill in. Placeholders only here.
#
# In production these live in **Dokploy's env editor** and reach the containers
# through `docker-compose.prod.yml`'s explicit environment blocks. Nothing in
# this repo reads a credential from a file on disk except the keyfile, which
# mongod requires to be one.
#
# Generate every password with:  openssl rand -base64 32
# Use a DIFFERENT one for each. Shared credentials make the per-database
# isolation below decorative.
# ─────────────────────────────────────────────────────────────────────────────

# ── Paths on the host ────────────────────────────────────────────────────────
# **__MKTRUE_NAME__'s EXISTING mongo data directory.** This is the whole point of the
# migration: the instance adopts these files in place, so there is no dump, no
# restore, and no window in which the journal is in flight. __MKTRUE_NAME__'s
# __MKTRUE_NAME_UPPER___DATA_DIR is /volumes-__MKTRUE_NAME__, so this is /volumes-__MKTRUE_NAME__/mongo — the
# directory holding WiredTiger and the collection-*.wt files.
#
# Getting this wrong starts an EMPTY database that looks exactly like total data
# loss. `scripts/preflight.sh` checks it before you can find that out the hard
# way.
MONGO_DATA_DIR=/volumes-__MKTRUE_NAME__/mongo

# The replica-set internal-auth keyfile. Created once by
# `scripts/generate-keyfile.sh`, mode 400, owner 999:999. NOT in this file and
# not in Dokploy — mongod wants a file, and a 1024-character secret does not
# belong in a textarea.
MONGO_KEYFILE=/volumes-__MKTRUE_NAME__/infra/keyfile

# Where archives are written. One per database per UTC day, 14-day retention.
INFRA_BACKUP_DIR=/volumes-__MKTRUE_NAME__/infra/backups

# ── The shared network ───────────────────────────────────────────────────────
# Created and owned by THIS project. __MKTRUE_NAME__ and __MKTRUE_NAME__-the most exposed consumer both declare it
# `external: true` under this exact name, so this stack deploys first.
INFRA_NETWORK=__MKTRUE_NAME__-infra

# ── Consumers ────────────────────────────────────────────────────────────────
# Every product this instance serves, as a space-separated list of slugs. Each
# one gets its own database, its own user and its own password, and can read
# nothing but its own database. `scripts/verify.sh` proves that by trying.
#
# Adding a consumer here is the whole change: the bootstrap, the backup loop and
# the verifier all read this list. None of them knows a product name.
INFRA_CONSUMERS=__MKTRUE_CONSUMERS__

# Per consumer, upper-cased: <SLUG>_DB_NAME, <SLUG>_DB_USER, <SLUG>_DB_PASSWORD.
# The name must match what the application already connects to; changing it here
# renames nothing, it points a user at a database that does not exist.
#
# The administrator. `root` on admin — the only account that can manage users,
# and no application ever authenticates as it. It exists for the bootstrap
# script and for a human at 02:00.
MONGO_ADMIN_USER=infra_admin
MONGO_ADMIN_PASSWORD=

__MKTRUE_CONSUMER_ENV__

# Backups: reads everything, writes nothing (`backup` role).
BACKUP_DB_USER=backup_agent
BACKUP_DB_PASSWORD=

# ── Backups ──────────────────────────────────────────────────────────────────
RETENTION_DAYS=14

# ── Rotation ─────────────────────────────────────────────────────────────────
# Normally unset. Set to `true` for ONE deploy to make the bootstrap script
# rewrite every password from the values above, then unset it again. Left on, a
# deploy with a stale env silently locks an app out of its own database.
ROTATE_PASSWORDS=
