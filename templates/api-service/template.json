{
  "schema": 1,
  "name": "api-service",
  "version": "0.1.0",
  "description": "An authenticated, multi-tenant HTTP API: a gate that refuses by default, a tenancy guard that throws before I/O, and one placeholder context to copy.",
  "slots": {
    "NAME": {
      "from": "answers.name",
      "required": true,
      "kind": "text"
    },
    "NAME_UPPER": {
      "from": "derived.nameUpper",
      "required": true,
      "kind": "text"
    },
    "OWNER": {
      "from": "answers.owner",
      "required": true,
      "kind": "text"
    },
    "LOCALES": {
      "from": "derived.localesLiteral",
      "required": true,
      "kind": "text"
    },
    "API_PORT": {
      "from": "answers.ports.api",
      "required": true,
      "kind": "text"
    }
  },
  "files": [
