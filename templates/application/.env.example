# __MKTRUE_NAME__ — the environment contract. Placeholders only. A fresh clone runs with every
# value blank: auth answers 503 and Mongo reports "disconnected". See docs/security.md.

# ── services/api ────────────────────────────────────────────────────────────
# PORT=__MKTRUE_API_PORT__
# HOST=0.0.0.0                   # must be loopback while DEV_AUTH_USER_ID is set
# API_VERSION=0.1.0
# GIT_SHA=                       # set by the image build; blank in dev

MONGO_URI=                       # a replica set, even single-node: mongodb://localhost:27017/?replicaSet=rs0
MONGO_DB_NAME=__MKTRUE_NAME__

DEFAULT_TIMEZONE=                # IANA zone for users who never chose one; blank means Europe/Madrid

CLERK_SECRET_KEY=                # both provider values are needed; either blank answers 503
CLERK_ISSUER=

OWNER_USER_ID=                   # the administrator; blank answers 503 on every gated route
ALLOWED_USER_IDS=                # who is admitted, comma or space separated; blank means the owner alone
DEV_AUTH_USER_ID=                # local development only; refused anywhere else

# ── apps/web ────────────────────────────────────────────────────────────────
# Where the web reaches the API, on the server only. Blank refuses, and no default exists in
# code: every call answers "unavailable" before a token is minted or anything is fetched. The
# value below is the API's development port on this machine. Production names the API's
# private address.
API_BASE_URL=http://localhost:__MKTRUE_API_PORT__
