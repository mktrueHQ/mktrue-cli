{
  "schema": 1,
  "version": "1.1.0",
  "slotSyntax": "__MKTRUE_<KEY>__",
  "slots": {
    "NAME": {
      "from": "answers.name",
      "required": true,
      "kind": "text"
    },
    "PURPOSE": {
      "from": "answers.purpose",
      "required": true,
      "kind": "text"
    },
    "OWNER": {
      "from": "answers.owner",
      "required": true,
      "kind": "text"
    },
    "AUDIENCE_TEST": {
      "from": "answers.audienceTest",
      "required": true,
      "kind": "text"
    },
    "STAKES": {
      "from": "answers.stakes",
      "required": true,
      "kind": "text"
    },
    "DATA_CLASSES": {
      "from": "answers.dataClasses",
      "required": true,
      "kind": "list",
      "empty": "nothing sensitive"
    },
    "AUTH": {
      "from": "answers.auth",
      "required": true,
      "kind": "text"
    },
    "LANGUAGES": {
      "from": "answers.languages",
      "required": true,
      "kind": "list"
    },
    "GATES": {
      "from": "derived.gates",
      "required": true,
      "kind": "list"
    },
    "AUDIT_TRIGGERS": {
      "from": "config.auditTriggers",
      "required": true,
      "kind": "list"
    },
    "BASE_BRANCH": {
      "from": "config.baseBranch",
      "required": true,
      "kind": "text"
    },
    "BUDGET_RULES": {
      "from": "config.budgets.rules",
      "required": true,
      "kind": "number"
    },
    "BUDGET_STATE": {
      "from": "config.budgets.state",
      "required": true,
      "kind": "number"
    },
    "BUDGET_DECISION": {
      "from": "config.budgets.decision",
      "required": true,
      "kind": "number"
    },
    "KIT_VERSION": {
      "from": "derived.kitVersion",
      "required": true,
      "kind": "text"
    },
    "TEMPLATE": {
      "from": "derived.template",
      "required": true,
      "kind": "text"
    },
    "TEMPLATE_VERSION": {
      "from": "derived.templateVersion",
      "required": true,
      "kind": "text"
    },
    "DATE": {
      "from": "derived.date",
      "required": true,
      "kind": "text"
    },
    "ROLE_ID": {
      "from": "derived.roleId",
      "required": true,
      "kind": "path"
    },
    "COMMAND_ID": {
      "from": "derived.commandId",
      "required": true,
      "kind": "path"
    },
    "REFERENCE_ID": {
      "from": "derived.referenceId",
      "required": true,
      "kind": "path"
    },
    "PATH_STATE": {
      "from": "config.paths.state",
      "required": true,
      "kind": "path"
    },
    "PATH_ROADMAP": {
      "from": "config.paths.roadmap",
      "required": true,
      "kind": "path"
    },
    "PATH_DECISIONS_INDEX": {
      "from": "config.paths.decisionsIndex",
      "required": true,
      "kind": "path"
    },
    "PATH_DECISIONS": {
      "from": "config.paths.decisions",
      "required": true,
      "kind": "path"
    },
    "PATH_DESIGN": {
      "from": "config.paths.design",
      "required": true,
      "kind": "path"
    },
    "PATH_LOG": {
      "from": "config.paths.log",
      "required": true,
      "kind": "path"
    }
  },
  "roles": [
    {
      "id": "architect",
      "title": "Architect",
      "body": "agents/architect.md",
      "description": "Use at the start of a milestone, or when a change spans more than one boundary, to get the milestone plan and its kickoff page in docs/design/; it never writes production code.",
      "tools": ["Read", "Write", "Edit", "Bash", "Grep", "Glob"],
      "model": "opus",
      "effort": "xhigh",
      "slots": ["NAME", "PURPOSE"],
      "report": "<main checkout>/.mktrue/slices/<milestone>-kickoff/architect.md"
    },
    {
      "id": "implementer",
      "title": "Implementer",
      "body": "agents/implementer.md",
      "description": "Use when a slice's brief is written and its surface is not the interface, to build the change with its tests and one full gate run; it never commits, pushes or opens a pull request.",
      "tools": ["Read", "Write", "Edit", "Bash", "Grep", "Glob"],
      "model": "opus",
      "effort": "high",
      "slots": [],
      "report": "<slice folder>/implementer.md"
    },
    {
      "id": "ui-engineer",
      "title": "UI engineer",
      "body": "agents/ui-engineer.md",
      "description": "Use when a slice's surface is the interface (screens, charts, theming, accessibility, responsive or offline behaviour), to build it and verify it at 360px; it never hardcodes a string or a raw design value.",
      "tools": ["Read", "Write", "Edit", "Bash", "Grep", "Glob"],
      "model": "opus",
      "effort": "high",
      "slots": ["NAME", "AUDIENCE_TEST", "LANGUAGES"],
      "report": "<slice folder>/ui-engineer.md"
    },
    {
      "id": "security-auditor",
      "title": "Security auditor",
      "body": "agents/security-auditor.md",
      "description": "Use before merging a slice whose diff touches a trigger surface, to get findings ranked by severity and a safe-to-merge or blocked verdict; it is read-only and never writes exploits.",
      "tools": ["Read", "Grep", "Glob", "Bash"],
      "model": "opus",
      "effort": "high",
      "slots": ["NAME", "STAKES", "DATA_CLASSES", "AUDIT_TRIGGERS"],
      "report": "<slice folder>/audit.md"
    },
    {
      "id": "reviewer",
      "title": "Reviewer",
      "body": "agents/reviewer.md",
      "description": "Use after a slice is built, and after its audit if one ran, to get findings ranked by severity, verified by planting deliberate bugs, and an approve or revise verdict; it never edits a file.",
      "tools": ["Read", "Bash", "Grep", "Glob"],
      "model": "opus",
      "effort": "high",
      "slots": [],
      "report": "<slice folder>/review.md"
    },
    {
      "id": "docs-writer",
      "title": "Docs writer",
      "body": "agents/docs-writer.md",
      "description": "Use at a milestone boundary, or whenever behaviour has drifted from what the docs claim, to bring the README, the decision index, plans, the roadmap, the environment example and docs/STATE.md back to the truth; it never documents what does not exist.",
      "tools": ["Read", "Write", "Edit", "Bash", "Grep", "Glob"],
      "model": "sonnet",
      "effort": "low",
      "slots": ["NAME", "OWNER", "BUDGET_STATE", "BUDGET_RULES"],
      "report": "<slice folder>/docs.md"
    }
  ],
  "contracts": [
    {
      "id": "loop-contract",
      "title": "The loop contract",
      "body": "loop-contract.md",
      "renderTo": ".claude/agents/README.md",
      "slots": ["AUDIT_TRIGGERS", "GATES"]
    }
  ],
  "commands": [
    {
      "id": "start-milestone",
      "title": "Start a milestone",
      "body": "commands/start-milestone.md",
      "slots": []
    },
    {
      "id": "brief",
      "title": "Write the brief",
      "body": "commands/brief.md",
      "slots": ["AUDIT_TRIGGERS"]
    },
    {
      "id": "start-slice",
      "title": "Start a slice",
      "body": "commands/start-slice.md",
      "slots": ["AUDIT_TRIGGERS"]
    },
    {
      "id": "close-slice",
      "title": "Close a slice",
      "body": "commands/close-slice.md",
      "slots": ["GATES", "BUDGET_STATE", "BASE_BRANCH"]
    },
    {
      "id": "new-module",
      "title": "Scaffold a module",
      "body": "commands/new-module.md",
      "slots": []
    },
    {
      "id": "create-roadmap",
      "title": "Create the roadmap",
      "body": "commands/create-roadmap.md",
      "slots": ["BUDGET_STATE"]
    },
    {
      "id": "update-roadmap",
      "title": "Update the roadmap",
      "body": "commands/update-roadmap.md",
      "slots": ["BUDGET_STATE"]
    }
  ],
  "references": [
    {
      "id": "plant",
      "title": "Plant a bug",
      "body": "references/plant.md",
      "slots": []
    },
    {
      "id": "worktree",
      "title": "Work in a worktree",
      "body": "references/worktree.md",
      "slots": ["BASE_BRANCH"]
    }
  ],
  "workflows": [
    {
      "id": "mktrue",
      "title": "The kit's check, on every push",
      "body": "workflows/mktrue.yml",
      "renderTo": ".github/workflows/mktrue.yml",
      "slots": ["KIT_VERSION"]
    }
  ],
  "rules": [
    {
      "section": 1,
      "title": "Where to look first",
      "body": "rules/01-where-to-look-first.md",
      "owner": "kit",
      "slots": [
        "NAME",
        "PURPOSE",
        "KIT_VERSION",
        "PATH_STATE",
        "PATH_ROADMAP",
        "PATH_DECISIONS_INDEX",
        "PATH_DECISIONS",
        "PATH_DESIGN",
        "PATH_LOG"
      ]
    },
    {
      "section": 2,
      "title": "Stack and versions",
      "body": "rules/02-stack-and-versions.md",
      "owner": "repo",
      "slots": []
    },
    {
      "section": 3,
      "title": "Architecture and boundaries",
      "body": "rules/03-architecture-and-boundaries.md",
      "owner": "repo",
      "slots": []
    },
    {
      "section": 4,
      "title": "How work runs",
      "body": "rules/04-how-work-runs.md",
      "owner": "repo",
      "slots": ["GATES"]
    },
    {
      "section": 5,
      "title": "Testing and plants",
      "body": "rules/05-testing-and-plants.md",
      "owner": "repo",
      "slots": []
    },
    {
      "section": 6,
      "title": "Security posture and data classes",
      "body": "rules/06-security-and-data-classes.md",
      "owner": "repo",
      "slots": ["DATA_CLASSES", "AUTH", "AUDIT_TRIGGERS"]
    },
    {
      "section": 7,
      "title": "Conventions",
      "body": "rules/07-conventions.md",
      "owner": "repo",
      "slots": ["LANGUAGES"]
    },
    {
      "section": 8,
      "title": "What agents may and may not do",
      "body": "rules/08-agent-permissions.md",
      "owner": "repo",
      "slots": []
    },
    {
      "section": 9,
      "title": "Budgets and drift",
      "body": "rules/09-budgets-and-drift.md",
      "owner": "repo",
      "slots": ["BUDGET_RULES", "BUDGET_STATE", "BUDGET_DECISION"]
    },
    {
      "section": 10,
      "title": "Where things live",
      "body": "rules/10-where-things-live.md",
      "owner": "repo",
      "slots": []
    }
  ],
  "docs": [
    {
      "id": "state",
      "title": "State",
      "body": "docs/state.md",
      "renderTo": "docs/STATE.md",
      "slots": ["NAME"]
    },
    {
      "id": "design-plan",
      "title": "Milestone plan",
      "body": "docs/design-plan.md",
      "renderTo": "docs/design/",
      "slots": []
    },
    {
      "id": "decision",
      "title": "Decision",
      "body": "docs/decision.md",
      "renderTo": "docs/decisions/",
      "slots": ["BUDGET_DECISION"]
    },
    {
      "id": "log-entry",
      "title": "Log entry",
      "body": "docs/log-entry.md",
      "renderTo": "docs/log/",
      "slots": []
    },
    {
      "id": "created-log",
      "title": "The created log",
      "body": "docs/created.md",
      "renderTo": "docs/log/",
      "slots": [
        "NAME",
        "DATE",
        "KIT_VERSION",
        "TEMPLATE",
        "TEMPLATE_VERSION",
        "PURPOSE",
        "OWNER",
        "AUTH",
        "LANGUAGES",
        "DATA_CLASSES",
        "GATES"
      ]
    },
    {
      "id": "roadmap",
      "title": "Roadmap",
      "body": "docs/roadmap.md",
      "renderTo": "docs/ROADMAP.md",
      "slots": ["NAME"]
    },
    {
      "id": "decisions-index",
      "title": "Decisions index",
      "body": "docs/decisions-index.md",
      "renderTo": "docs/decisions/index.md",
      "slots": []
    },
    {
      "id": "design-readme",
      "title": "Design",
      "body": "docs/design-readme.md",
      "renderTo": "docs/design/README.md",
      "slots": []
    }
  ],
  "targets": {
    "claude-code": {
      "roles": ".claude/agents/__MKTRUE_ROLE_ID__.md",
      "commands": ".claude/commands/__MKTRUE_COMMAND_ID__.md",
      "references": ".claude/reference/__MKTRUE_REFERENCE_ID__.md",
      "rules": "CLAUDE.md",
      "settings": ".claude/settings.json",
      "settingsBody": "settings/claude-code.json",
      "roleFrontmatter": ["name", "description", "tools", "model", "effort"],
      "vocabulary": {
        "models": ["opus", "sonnet", "haiku", "inherit"],
        "efforts": ["low", "medium", "high", "xhigh", "max"],
        "effortUnsupportedOn": ["haiku"]
      }
    }
  }
}
