{
  "name": "mktrue-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "node packages/cli/dist/mktrue.js check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --continue",
    "golden": "node scripts/golden-templates.mjs",
    "lock:templates": "node scripts/lock-templates.mjs",
    "version-packages": "changeset version && node scripts/sync-kit-version.mjs && node scripts/embed-bench.mjs && node scripts/restamp-kit-render.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "commitlint": "commitlint"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "postject": "1.0.0-alpha.6",
    "prettier": "^3",
    "turbo": "^2",
    "typescript": "^5"
  }
}
